# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts. Not a bare *.out: that
# swallows a testdata fixture, and coverage.out already matches coverage.*.
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.DS_Store
.cursor/

# Built binary at repo root, not the cmd/zen-review package directory
/zen-review
/main

dist/
.gocache/

# Claude Code local settings
.claude/settings.local.json
